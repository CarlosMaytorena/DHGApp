@model AgricolaDH_GApp.ViewModels.RequisicionesVM
@{
    var cw = (ViewBag.ClosedWeeks as int?) ?? 1;
    var rw = (ViewBag.RejectedWeeks as int?) ?? 1;
}

<style>
    .tools-inline {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: auto;
    }
</style>

<div class="text-center">

    <div class="row top-row-spacer">
        <div class="col-md-6">
            <h4 class="page-title">Requisición</h4>
        </div>

        <div class="col-md-4">
        </div>

        <div class="col-md-2">
            <button id="crearRequisicion" class="btn btn-block secondary-background-color" style="color: white">
                <i class="nav-icon fas fa-arrow-plus"></i>
                Crear Requisición
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-12">

            <!-- Requisiciones Enviadas -->
            <div class="card card-margin">
                <div class="card-header">
                    <h3 class="card-title">Requisiciones Enviadas</h3>

                    <div class="card-tools">
                        <div class="input-group input-group-sm" style="width: 150px;">
                            <input type="text" name="table_search" id="requisiciones_tableSearch" class="form-control float-right" placeholder="Search">
                            <div class="input-group-append">
                                <button type="button" id="requisicones_searchButton" class="btn btn-default">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body table-responsive p-0" style="height: 300px;">
                    <table id="requisicionesTable" class="table table-head-fixed text-nowrap">
                        <thead>
                            <tr>
                                <th style="width:30px">Acción</th>
                                <th>ID</th>
                                <th>Fecha</th>
                                <th>Solicitante</th>
                                <th>Status</th>
                                <th>Área</th>
                                <th>Cultivo</th>
                                <th>Rancho</th>
                                <th>Temporada</th>
                                <th>Comentarios</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.requisicionList.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <a href="#" id="@Model.requisicionList[i].IdOrdenDeCompra" class="editarRequisicion" style="color: #2E2E2E">
                                            <i class="nav-icon fas fa-pen"></i>
                                        </a>
                                        <a href="#" id="@Model.requisicionList[i].IdOrdenDeCompra" class="imprimirRequisicion" style="color: #2E2E2E">
                                            <i class="nav-icon fas fa-print"></i>
                                        </a>
                                    </td>
                                    <td>@Model.requisicionList[i].IdOrdenDeCompra</td>
                                    <td>@Model.requisicionList[i].FechaRequisicion.ToShortDateString()</td>
                                    <td>@Model.requisicionList[i].Solicitante</td>
                                    <td>@Model.requisicionList[i].Proveedor</td>
                                    <td>@Model.requisicionList[i].Area</td>
                                    <td>@Model.requisicionList[i].Cultivo</td>
                                    <td>@Model.requisicionList[i].Rancho</td>
                                    <td>@Model.requisicionList[i].Temporada</td>
                                    <td>@Model.requisicionList[i].Comentarios</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Requisiciones En Proceso (Aceptado/PorIngresar/Ingresado) -->
            <div class="card card-margin">
                <div class="card-header d-flex align-items-center">
                    <h3 class="card-title mb-0">Requisiciones En Proceso</h3>

                    <div class="tools-inline">
                        <!-- Search local por ID en aceptadas -->
                        <div class="input-group input-group-sm" style="width: 150px;">
                            <input type="text" id="requisicionesAceptadas_tableSearch" class="form-control" placeholder="Search">
                            <div class="input-group-append">
                                <button type="button" id="requisicionesAceptadas_searchButton" class="btn btn-default">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body table-responsive p-0" style="height: 300px;">
                    <table id="requisicionesAceptadasTable" class="table table-head-fixed text-nowrap">
                        <thead>
                            <tr>
                                <th style="width:60px">Acción</th>
                                <th>ID</th>
                                <th>Fecha</th>
                                <th>Solicitante</th>
                                <th>Proveedor</th>
                                <th>Status</th>
                                <th>Área</th>
                                <th>Cultivo</th>
                                <th>Rancho</th>
                                <th>Temporada</th>
                                <th>Comentarios</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.requisicionAceptadaList.Count; i++)
                            {
                                string statusTexto = Model.requisicionAceptadaList[i].IdOrdenDeCompraStatus switch
                                {
                                    AgricolaDH_GApp.Models.OrdenDeCompraStatusEnumerators.Aceptado => "Aceptado",
                                    AgricolaDH_GApp.Models.OrdenDeCompraStatusEnumerators.PorIngresar => "Por Ingresar",
                                    AgricolaDH_GApp.Models.OrdenDeCompraStatusEnumerators.Ingresado => "Ingresado",
                                    _ => ""
                                };
                                <tr>
                                    <td>
                                        <a href="#" id="@Model.requisicionAceptadaList[i].IdOrdenDeCompra" class="editarRequisicion" style="color: #2E2E2E">
                                            <i class="nav-icon fas fa-eye"></i>
                                        </a>
                                        <a href="#" id="@Model.requisicionAceptadaList[i].IdOrdenDeCompra" class="imprimirRequisicion" style="color: #2E2E2E">
                                            <i class="nav-icon fas fa-print"></i>
                                        </a>
                                        @if (Model.puedeCerrar)
                                        {
                                            <a href="#" id="@Model.requisicionAceptadaList[i].IdOrdenDeCompra" class="cerrarRequisicion" style="color: #2E2E2E">
                                                <i class="nav-icon fas fa-lock"></i>
                                            </a>
                                        }
                                    </td>
                                    <td>@Model.requisicionAceptadaList[i].IdOrdenDeCompra</td>
                                    <td>@Model.requisicionAceptadaList[i].FechaRequisicion.ToShortDateString()</td>
                                    <td>@Model.requisicionAceptadaList[i].Solicitante</td>
                                    <td>@Model.requisicionAceptadaList[i].Proveedor</td>
                                    <td>@statusTexto</td>
                                    <td>@Model.requisicionAceptadaList[i].Area</td>
                                    <td>@Model.requisicionAceptadaList[i].Cultivo</td>
                                    <td>@Model.requisicionAceptadaList[i].Rancho</td>
                                    <td>@Model.requisicionAceptadaList[i].Temporada</td>
                                    <td>@Model.requisicionAceptadaList[i].Comentarios</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Requisiciones Cerradas -->
            <div class="card card-margin">
                <div class="card-header d-flex align-items-center">
                    <h3 class="card-title mb-0">Requisiciones Cerradas</h3>

                    <div class="tools-inline">
                        <!-- Filtro de periodo para cerradas -->
                        <select id="closedWeeksSelect" class="form-control form-control-sm" style="width: 160px;">
                            <option value="1" selected="@(cw == 1 ? "selected" : null)">Última semana</option>
                            <option value="4" selected="@(cw == 4 ? "selected" : null)">Último mes</option>
                            <option value="52" selected="@(cw == 52 ? "selected" : null)">Último año</option>
                            <option value="0" selected="@(cw == 0 ? "selected" : null)">Todas</option>
                        </select>

                        <!-- Search local por ID en cerradas -->
                        <div class="input-group input-group-sm" style="width: 150px;">
                            <input type="text" id="requisicionesCerradas_tableSearch" class="form-control" placeholder="Search">
                            <div class="input-group-append">
                                <button type="button" id="requisicionesCerradas_searchButton" class="btn btn-default">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body table-responsive p-0" style="height: 300px;">
                    <table id="requisicionesCerradasTable" class="table table-head-fixed text-nowrap">
                        <thead>
                            <tr>
                                <th style="width:60px">Acción</th>
                                <th>ID</th>
                                <th>Fecha</th>
                                <th>Solicitante</th>
                                <th>Status</th>
                                <th>Área</th>
                                <th>Cultivo</th>
                                <th>Rancho</th>
                                <th>Temporada</th>
                                <th>Comentarios</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.requisicionCerradaList.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <a href="#" id="@Model.requisicionCerradaList[i].IdOrdenDeCompra" class="editarRequisicion" style="color: #2E2E2E">
                                            <i class="nav-icon fas fa-eye"></i>
                                        </a>
                                        <a href="#" id="@Model.requisicionCerradaList[i].IdOrdenDeCompra" class="imprimirRequisicion" style="color: #2E2E2E">
                                            <i class="nav-icon fas fa-print"></i>
                                        </a>
                                    </td>
                                    <td>@Model.requisicionCerradaList[i].IdOrdenDeCompra</td>
                                    <td>@Model.requisicionCerradaList[i].FechaRequisicion.ToShortDateString()</td>
                                    <td>@Model.requisicionCerradaList[i].Solicitante</td>
                                    <td>@Model.requisicionCerradaList[i].Proveedor</td>
                                    <td>@Model.requisicionCerradaList[i].Area</td>
                                    <td>@Model.requisicionCerradaList[i].Cultivo</td>
                                    <td>@Model.requisicionCerradaList[i].Rancho</td>
                                    <td>@Model.requisicionCerradaList[i].Temporada</td>
                                    <td>@Model.requisicionCerradaList[i].Comentarios</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Requisiciones Rechazadas -->
            <div class="card card-margin">
                <div class="card-header d-flex align-items-center">
                    <h3 class="card-title mb-0">Requisiciones Rechazadas</h3>

                    <div class="tools-inline">
                        <!-- Filtro de periodo para rechazadas -->
                        <select id="rejectedWeeksSelect" class="form-control form-control-sm" style="width: 160px;">
                            <option value="1" selected="@(rw == 1 ? "selected" : null)">Última semana</option>
                            <option value="4" selected="@(rw == 4 ? "selected" : null)">Último mes</option>
                            <option value="52" selected="@(rw == 52 ? "selected" : null)">Último año</option>
                            <option value="0" selected="@(rw == 0 ? "selected" : null)">Todas</option>
                        </select>

                        <!-- Search local por ID en rechazadas -->
                        <div class="input-group input-group-sm" style="width: 150px;">
                            <input type="text" id="requisicionesRechazadas_tableSearch" class="form-control" placeholder="Search">
                            <div class="input-group-append">
                                <button type="button" id="requisicionesRechazadas_searchButton" class="btn btn-default">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body table-responsive p-0" style="height: 300px;">
                    <table id="requisicionesRechazadasTable" class="table table-head-fixed text-nowrap">
                        <thead>
                            <tr>
                                <th style="width:60px">Acción</th>
                                <th>ID</th>
                                <th>Fecha</th>
                                <th>Solicitante</th>
                                <th>Status</th>
                                <th>Área</th>
                                <th>Cultivo</th>
                                <th>Rancho</th>
                                <th>Temporada</th>
                                <th>Comentarios</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.requisicionRechazadaList.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <a href="#" id="@Model.requisicionRechazadaList[i].IdOrdenDeCompra" class="editarRequisicion" style="color: #2E2E2E">
                                            <i class="nav-icon fas fa-eye"></i>
                                        </a>
                                        <a href="#" id="@Model.requisicionRechazadaList[i].IdOrdenDeCompra" class="imprimirRequisicion" style="color: #2E2E2E">
                                            <i class="nav-icon fas fa-print"></i>
                                        </a>
                                    </td>
                                    <td>@Model.requisicionRechazadaList[i].IdOrdenDeCompra</td>
                                    <td>@Model.requisicionRechazadaList[i].FechaRequisicion.ToShortDateString()</td>
                                    <td>@Model.requisicionRechazadaList[i].Solicitante</td>
                                    <td>@Model.requisicionRechazadaList[i].Proveedor</td>
                                    <td>@Model.requisicionRechazadaList[i].Area</td>
                                    <td>@Model.requisicionRechazadaList[i].Cultivo</td>
                                    <td>@Model.requisicionRechazadaList[i].Rancho</td>
                                    <td>@Model.requisicionRechazadaList[i].Temporada</td>
                                    <td>@Model.requisicionRechazadaList[i].Comentarios</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modal-cerrarRequisicionConfirm">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Cerrar Requisición</h4>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-crear-body">
                <p style="margin-left: 10px">¿Seguro que desea cerrar esta requisición? Ya no se podrán subir facturas ni registrar ingresos.</p>
                <div id="resumenFacturacionCierre"></div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-bs-dismiss="modal">Cancelar</button>
                <button id="cerrarRequisicionConfirm" type="button" class="btn btn-danger">Cerrar Requisición</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<script>
    $(document).ready(function () {

        //  Navegación / abrir formularios 
        $("#crearRequisicion").click(function () {
            $.ajax({
                type: "POST",
                url: '@Url.Action("CrearRequisicion", "Requisicion")',
                contentType: "application/json; charset=utf-8",
                data: {},
                success: function (data) {
                    $("#HtmlBody").html(data);
                }
            });
        });

        $(".editarRequisicion").click(function () {
            var IdOrdenDeCompra = $(this).attr("id");
            $.ajax({
                type: "POST",
                url: '@Url.Action("EditarRequisicion", "Requisicion")',
                data: { IdOrdenDeCompra: IdOrdenDeCompra },
                success: function (data) {
                    $("#HtmlBody").html(data);
                }
            });
        });

        $(".imprimirRequisicion").click(function (e) {
            e.preventDefault();
            var IdOrdenDeCompra = $(this).attr("id");
            window.open('@Url.Action("ImprimirRequisicion", "Requisicion")' + '?IdOrdenDeCompra=' + IdOrdenDeCompra, '_blank');
        });

        var idOrdenDeCompraACerrar = null;

        $(".cerrarRequisicion").click(function (e) {
            e.preventDefault();
            idOrdenDeCompraACerrar = $(this).attr("id");

            $("#resumenFacturacionCierre").html("");

            $.ajax({
                type: "POST",
                url: '@Url.Action("ResumenFacturacion", "Requisicion")',
                data: { IdOrdenDeCompra: idOrdenDeCompraACerrar },
                success: function (data) {
                    $("#resumenFacturacionCierre").html(data);
                }
            });

            $("#modal-cerrarRequisicionConfirm").modal("show");
        });

        $("#cerrarRequisicionConfirm").click(function () {
            $("#modal-cerrarRequisicionConfirm").modal("hide");

            $.ajax({
                type: "POST",
                url: '@Url.Action("CerrarRequisicion", "Requisicion")',
                data: { IdOrdenDeCompra: idOrdenDeCompraACerrar },
                success: function (data) {
                    $("#HtmlBody").html(data.url);
                }
            });
        });

        // Búsqueda local 
        function searchTableById($table, query) {
            query = (query || "").toLowerCase();
            $table.find("tbody tr").each(function () {
                let idText = ($(this).find("td:eq(1)").text() || "").toLowerCase();
                $(this).toggle(idText.includes(query));
            });
        }

        // Enviadas
        $("#requisicones_searchButton").click(function () {
            const q = $("#requisiciones_tableSearch").val();
            searchTableById($("#requisicionesTable"), q);
        });
        $("#requisiciones_tableSearch").keypress(function (e) {
            if (e.which === 13) {
                const q = $(this).val();
                searchTableById($("#requisicionesTable"), q);
            }
        });

        // Aceptadas
        $("#requisicionesAceptadas_searchButton").click(function () {
            const q = $("#requisicionesAceptadas_tableSearch").val();
            searchTableById($("#requisicionesAceptadasTable"), q);
        });
        $("#requisicionesAceptadas_tableSearch").keypress(function (e) {
            if (e.which === 13) {
                const q = $(this).val();
                searchTableById($("#requisicionesAceptadasTable"), q);
            }
        });

        // Cerradas
        $("#requisicionesCerradas_searchButton").click(function () {
            const q = $("#requisicionesCerradas_tableSearch").val();
            searchTableById($("#requisicionesCerradasTable"), q);
        });
        $("#requisicionesCerradas_tableSearch").keypress(function (e) {
            if (e.which === 13) {
                const q = $(this).val();
                searchTableById($("#requisicionesCerradasTable"), q);
            }
        });

        // Rechazadas
        $("#requisicionesRechazadas_searchButton").click(function () {
            const q = $("#requisicionesRechazadas_tableSearch").val();
            searchTableById($("#requisicionesRechazadasTable"), q);
        });
        $("#requisicionesRechazadas_tableSearch").keypress(function (e) {
            if (e.which === 13) {
                const q = $(this).val();
                searchTableById($("#requisicionesRechazadasTable"), q);
            }
        });

        $("#closedWeeksSelect").on("change", function () {
            var closedWeeks = $(this).val();
            var rejectedWeeks = $("#rejectedWeeksSelect").val() || @rw;
            $.get('@Url.Action("Index", "Requisicion")', { closedWeeks: closedWeeks, rejectedWeeks: rejectedWeeks }, function (html) {
                $("#HtmlBody").html(html);
            });
        });

        $("#rejectedWeeksSelect").on("change", function () {
            var rejectedWeeks = $(this).val();
            var closedWeeks = $("#closedWeeksSelect").val() || @cw;
            $.get('@Url.Action("Index", "Requisicion")', { closedWeeks: closedWeeks, rejectedWeeks: rejectedWeeks }, function (html) {
                $("#HtmlBody").html(html);
            });
        });

    });
</script>
