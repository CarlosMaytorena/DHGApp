@model AgricolaDH_GApp.ViewModels.SubirFacturaVM

<div class="text-center">

    <div class="row top-row-spacer">
        <div class="col-md-8">
            <h4 class="page-title">@(Model.soloLectura ? "Ver orden" : "Ingresar")</h4>
        </div>
        <div class="col-md-2">
            <button id="volverAIndex" class="btn btn-block btn-secondary">
                Regresar
            </button>
        </div>
        @if (!Model.soloLectura)
        {
            <div class="col-md-2">
                <button id="realizarIngresoConfirm" class="btn btn-block secondary-background-color" style="color: white">
                    <i class="nav-icon fas fa-arrow-right"></i> Recibir
                </button>
            </div>
        }
    </div>

    <div class="card card-margin">
        <!-- Order and Date Section -->
        <div class="row card-row-spacer">
            <div class="col-md-8">
                <label style="font-weight: normal; text-align: left; float: left">Orden de compra</label>
                <input id="orderNumber" class="form-control" value="@Model.ordenDeCompra.IdOrdenDeCompra" readonly />
            </div>
            <div class="col-md-4">
                <label style="font-weight: normal; text-align: left; float: left">Fecha</label>
                <input type="date" class="form-control" value="@Model.ordenDeCompra.FechaOrdenDeCompra?.ToString("yyyy-MM-dd")" readonly />
            </div>
        </div>

        <!-- Dynamic Product Section -->
        <div class="row card-row-spacer">
            <label style="font-weight: normal; text-align: left; float: left; margin-right: 10px;">Productos</label>
            @if (!Model.soloLectura)
            {
                <select id="catalogoProductoSelect" class="form-control input-focus" style="width: auto; display: inline-block; margin-right: 10px;">
                    <option value="">Seleccionar producto...</option>
                    @foreach (var producto in Model.productoList)
                    {
                        <option value="@producto.IdProducto">@producto.NombreDropdown</option>
                    }
                </select>
                <button type="button" id="agregarProductoCatalogo" class="btn-sm secondary-background-color" style="color: white; border: 0px">
                    <i class="nav-icon fas fa-plus"></i>
                </button>
            }
        </div>

        <div id="productContainer">
            @if (Model.productosOrdenar != null && Model.productosOrdenar.Any())
            {
                <div class="row card-row-spacer">
                    <div class="col-md-3"><label style="font-weight: normal; text-align: left; float: left">Producto</label></div>
                    <div class="col-md-2"><label style="font-weight: normal; text-align: left; float: left">Cantidad Ordenada</label></div>
                    <div class="col-md-1"><label style="font-weight: normal; text-align: left; float: left">Recibido acumulado</label></div>
                    @if (!Model.soloLectura)
                    {
                        <div class="col-md-1"><label style="font-weight: normal; text-align: left; float: left">Recibir</label></div>
                    }
                    <div class="col-md-2"><label style="font-weight: normal; text-align: left; float: left">Precio unitario (factura)</label></div>
                    <div class="col-md-3"><label style="font-weight: normal; text-align: left; float: left">Total recibido</label></div>
                </div>
                @for (int i = 0; i < Model.productosOrdenar.Count; i++)
                {
                    bool esQuitable = !Model.soloLectura && Model.productosOrdenar[i].Cantidad == 0 && Model.productosOrdenar[i].RecibidoAcumulado == 0;
                    <div class="row card-row-spacer product-row">
                        <div class="col-md-3">
                            @Html.HiddenFor(m => m.productosOrdenar[i].IdProductoOrdenar)

                            <div style="display:flex; align-items:center; gap:6px;">
                                @Html.EditorFor(m => m.productosOrdenar[i].NombreDropdown,
                                    new { htmlAttributes = new { @class = "form-control input-focus subirFactura", @readonly = "true", @data_index = i } })
                                @if (esQuitable)
                                {
                                    <button type="button" class="btn-sm secondary-background-color quitar-producto-catalogo" style="color: white; border: 0px" title="Quitar">
                                        <i class="nav-icon fas fa-minus"></i>
                                    </button>
                                }
                            </div>
                            <input type="hidden" class="product-name-raw" value="@Model.productosOrdenar[i].Producto" />

                            <input type="hidden" class="product-id" value="@Model.productosOrdenar[i].IdProductoOrdenar" />
                            <input type="hidden" class="product-barcode" data-barcode-value="" />
                        </div>

                        <div class="col-md-2">
                            <input type="text" class="form-control cantidad-esperada" value="@Model.productosOrdenar[i].Cantidad" readonly />
                        </div>
                        <div class="col-md-1">
                            <input type="text"
                                   class="form-control cantidad-acumulada"
                                   value="@Model.productosOrdenar[i].RecibidoAcumulado"
                                   readonly
                                   data-acumulado-inicial="@Model.productosOrdenar[i].RecibidoAcumulado" />
                        </div>
                        @if (!Model.soloLectura)
                        {
                            <div class="col-md-1">
                                <input type="number"
                                       class="form-control cantidad-recibida"
                                       min="0"
                                       value="@Model.productosOrdenar[i].CantidadCapturada" />
                            </div>
                        }
                        <div class="col-md-2">
                            <input class="form-control" value="@(Model.productosOrdenar[i].PrecioUnitarioFactura?.ToString("C2") ?? "—")" readonly />
                        </div>
                        <div class="col-md-3">
                            <input class="form-control"
                                   value="@(Model.productosOrdenar[i].PrecioUnitarioFactura.HasValue
                                                ? (Model.productosOrdenar[i].RecibidoAcumulado * Model.productosOrdenar[i].PrecioUnitarioFactura.Value).ToString("C2")
                                                : "—")"
                                   readonly />
                        </div>
                    </div>
                }
                <div style="height: 30px;"></div>
            }
        </div>
    </div>
</div>

<script type="module">
    // ---- Short serial (12-char Crockford Base32 from SHA-256) ----
    const CROCKFORD = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";

    function scrambleSerial(serial) {
        if (!serial || serial.length !== 12) return serial;
        // "123456ABCDEF" -> "ABCDEF123456"
        return serial.substring(6) + serial.substring(0, 6);
    }

    function goToIngresosIndex() {
        $.ajax({
            url: '@Url.Action("Index", "Ingresos")',
            type: 'GET',
            success: function (data) {
                $("#HtmlBody").html(data);
            },
            error: function () {
                showWarning("Error al regresar al listado de Ingresos.");
            }
        });
    }

    function bytesToBase32(bytes, outLen) {
        let bits = 0, value = 0, out = "";
        for (let i = 0; i < bytes.length && out.length < outLen; i++) {
            value = (value << 8) | bytes[i];
            bits += 8;
            while (bits >= 5 && out.length < outLen) {
                out += CROCKFORD[(value >>> (bits - 5)) & 31];
                bits -= 5;
            }
        }
        if (out.length < outLen && bits > 0) {
            out += CROCKFORD[(value << (5 - bits)) & 31];
        }
        return out.padEnd(outLen, "0");
    }

    async function shortSerialFrom(pn, order, idx, length = 12) {
        const source = `${pn}|${order}|${idx}`;
        const data = new TextEncoder().encode(source);
        const hash = await crypto.subtle.digest("SHA-256", data);
        return bytesToBase32(new Uint8Array(hash), length);
    }

    // --------------------------------------------------------------

    import { openPrintWindow } from "/js/labelPrinter.js";

    function showWarning(msg) {
        $("#modal-warning-msg").text(msg);
        $("#modal-warning").modal("show");
    }

    function showSuccess(msg, showCancelar) {
        $("#modal-success-msg").text(msg);
        $("#modal-cancelarIngreso").toggle(!!showCancelar);
        $("#modal-success").modal("show");
    }

    // Id del último ingreso confirmado en esta sesión (mientras no se salga del módulo).
    window.lastIngresoId = null;

    $(document).ready(function () {

        $(document).on('input', '.cantidad-recibida', function () {
            let v = parseInt($(this).val(), 10);
            if (isNaN(v) || v < 0) v = 0;
            $(this).val(v);
        });

        $(".product-row").each(function () {
            const $row = $(this);
            const productName = $row.find(".product-name-raw").val();

            if (!productName) return;
            $.ajax({
                url: '/Ingresos/GetProductBarcodeID',
                type: 'GET',
                data: { nombreProducto: productName },
                success: function (response) {
                    if (response.success) {
                        $row.find(".product-barcode").data("barcode-value", response.barcodeID);
                    } else {
                        console.error(`Error: ${response.message}`);
                    }
                },
                error: function () { console.error("Error fetching product barcode."); }
            });
        });

        function recargarFormulario() {
            const idOrdenDeCompra = $("#orderNumber").val();
            $.ajax({
                url: '@Url.Action("VerOrden", "Ingresos")',
                type: 'POST',
                data: { idOrdenDeCompra: idOrdenDeCompra },
                success: function (data) { $("#HtmlBody").html(data); },
                error: function () { showWarning("Error al recargar la orden."); }
            });
        }

        $("#volverAIndex").click(function () {
            window.lastIngresoId = null;
            goToIngresosIndex();
        });

        function capturaPreviaActual() {
            const captura = [];
            $(".product-row").each(function () {
                const $row = $(this);
                const idProductoOrdenar = parseInt($row.find(".product-id").val(), 10);
                const cantidad = parseInt($row.find(".cantidad-recibida").val(), 10) || 0;
                if (idProductoOrdenar && cantidad > 0) {
                    captura.push({ IdProductoOrdenar: idProductoOrdenar, Cantidad: cantidad });
                }
            });
            return captura;
        }

        $("#agregarProductoCatalogo").click(function () {
            const idProducto = $("#catalogoProductoSelect").val();
            if (!idProducto) {
                showWarning("Selecciona un producto del catálogo.");
                return;
            }
            const idOrdenDeCompra = $("#orderNumber").val();
            $.ajax({
                url: '@Url.Action("AgregarProductoCatalogo", "Ingresos")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({
                    IdOrdenDeCompra: idOrdenDeCompra,
                    IdProducto: idProducto,
                    CapturaPrevia: capturaPreviaActual()
                }),
                success: function (data) { $("#HtmlBody").html(data); },
                error: function () { showWarning("Error al agregar el producto."); }
            });
        });

        $(document).on("click", ".quitar-producto-catalogo", function () {
            const $row = $(this).closest(".product-row");
            const idProductoOrdenar = $row.find(".product-id").val();
            const idOrdenDeCompra = $("#orderNumber").val();
            $.ajax({
                url: '@Url.Action("EliminarProductoCatalogo", "Ingresos")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({
                    IdOrdenDeCompra: idOrdenDeCompra,
                    IdProductoOrdenar: idProductoOrdenar,
                    CapturaPrevia: capturaPreviaActual()
                }),
                success: function (data) { $("#HtmlBody").html(data); },
                error: function () { showWarning("Error al quitar el producto."); }
            });
        });

        $("#modal-cancelarIngreso").click(function () {
            if (!window.lastIngresoId) return;
            $.ajax({
                url: '@Url.Action("CancelarIngreso", "Ingresos")',
                type: 'POST',
                data: { idIngreso: window.lastIngresoId },
                success: function (response) {
                    if (response.success) {
                        window.lastIngresoId = null;
                    }
                    $("#modal-success").modal("hide");
                    if (!response.success) {
                        showWarning(response.message || "No se pudo cancelar el ingreso.");
                    }
                },
                error: function () {
                    $("#modal-success").modal("hide");
                    showWarning("Error al cancelar el ingreso.");
                }
            });
        });

        $("#realizarIngresoConfirm").off("click").on("click", async function () {
            const receivedProducts = [];
            const labelsToPrint = [];
            const rows = $(".product-row").toArray();
            const workOrderNumber = $("#orderNumber").val();

            for (const el of rows) {
                const $row = $(el);
                const productId = $row.find(".product-id").val();
                const productName = $row.find("input[readonly]").first().val();
                const partNumber = $row.find(".product-barcode").data("barcode-value");
                const recibida = parseInt($row.find(".cantidad-recibida").val(), 10) || 0;
                const acumuladoBase = parseInt($row.find(".cantidad-acumulada").data("acumulado-inicial"), 10) || 0;

                if (!productName || !partNumber) continue;
                if (recibida <= 0) continue;

                const shortSerials = [];
                for (let i = 1; i <= recibida; i++) {
                    const unitIndex = acumuladoBase + i;
                    const shortSerial = (await shortSerialFrom(partNumber, workOrderNumber, unitIndex)).toUpperCase();
                    shortSerials.push(shortSerial);

                    const scrambled = scrambleSerial(shortSerial);

                    labelsToPrint.push(`
                            <div class="label">
                                <h4>Orden: ${workOrderNumber}</h4>
                                <h4>Producto: ${productName}</h4>
                                <h4 class="serial-header">Serial: ${scrambled}</h4>
                                <svg class="barcode"
                                    data-barcode-value="${shortSerial}"
                                    data-scrambled="${scrambled}"></svg>
                                <div class="serial-below">${scrambled}</div>
                            </div>
                        `);
                }

                receivedProducts.push({
                    IdProductoOrdenar: productId,
                    Recibida: recibida,
                    SerialesCortos: shortSerials
                });
            }

            if (receivedProducts.length === 0) {
                showWarning("No se han ingresado cantidades válidas.");
                return;
            }

            $.ajax({
                type: "POST",
                url: "/Ingresos/ActualizarPorRecibir",
                data: JSON.stringify(receivedProducts),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.success) {
                        window.lastIngresoId = response.idIngreso;

                        if (labelsToPrint.length > 0) {
                            openPrintWindow(labelsToPrint.join(''), workOrderNumber);
                        }

                        showSuccess("Ingreso registrado correctamente.", true);
                    } else {
                        showWarning("Hubo un error al actualizar los datos.");
                    }
                },
                error: function () {
                    showWarning("Error al enviar la solicitud.");
                }

            });
        });

        $("#modal-success").on("hidden.bs.modal", function () {
            // Se muestra tras "Recibir" o "Cancelar"; en ambos casos hay que refrescar
            // el "Recibido acumulado" y la disponibilidad del botón Cancelar.
            recargarFormulario();
        });
    });
</script>

<div class="modal fade" id="modal-success" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Confirmación</h4>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="modal-success-msg">Ingreso registrado correctamente.</p>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" id="modal-cancelarIngreso" class="btn btn-outline-danger" style="display:none">
                    Cancelar este ingreso
                </button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-warning">
    <div class="modal-dialog">
        <div class="modal-content bg-warning">
            <div class="modal-header">
                <h4 class="modal-title">Error</h4>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body bg-warning-subtle">
                <p id="modal-warning-msg"></p>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>
